-spacing:-1.6px;margin:7px 0 0}.section-desc{color:var(--muted);max-width:540px;margin:8px 0 0}.text-link{color:var(--cyan);font-weight:750;font-size:13px;white-space:nowrap}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.stat-card,.panel,.feature-card{background:linear-gradient(145deg,#151a2c,#101425);border:1px solid var(--line);border-radius:var(--radius)}.stat-card{padding:19px}.stat-label{color:var(--muted);font-size:12px}.stat-number{font-size:29px;font-weight:850;letter-spacing:-1px;margin:4px 0}.stat-foot{font-size:11px;color:var(--green)}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.feature-card{padding:22px;transition:.2s}.feature-card:hover{transform:translateY(-3px);border-color:#68f0e277}.feature-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;font-size:20px;margin-bottom:16px;background:#68f0e21a}.feature-card h3{margin:0 0 7px;font-size:17px}.feature-card p{color:var(--muted);font-size:13px;margin:0 0 15px}.feature-card .text-link{font-size:12px}.panel{padding:23px}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.tab{border:1px solid var(--line);color:var(--muted);background:#ffffff05;border-radius:9px;padding:8px 13px;font-size:12px;font-weight:800}.tab.selected{color:#08121a;background:var(--cyan);border-color:var(--cyan)}.list-tools{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:15px}.search{width:min(310px,100%);background:#0b0e1b;border:1px solid var(--line);color:var(--text);padding:10px 12px;border-radius:10px;outline:none}.search:focus,input:focus,select:focus{border-color:var(--cyan)!important;box-shadow:0 0 0 3px #68f0e218}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:560px}th{text-align:left;color:#76809e;text-transform:uppercase;letter-spacing:.8px;font-size:10px;padding:11px;border-bottom:1px solid var(--line)}td{padding:14px 11px;border-bottom:1px solid #ffffff0b;font-size:13p