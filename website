ed);font-size:12px}.footer-inner{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.footer b{color:var(--text)}.disclaimer{max-width:620px}.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);background:#202741;border:1px solid var(--line);padding:10px 16px;border-radius:10px;opacity:0;transition:.2s;pointer-events:none;z-index:30}.toast.show{opacity:1;transform:translate(-50%,0)}
    @media(max-width:850px){.hero{grid-template-columns:1fr;gap:5px;padding-top:60px}.hero-art{min-height:285px}.navlinks{gap:0}.navlinks a{padding:9px 8px;font-size:12px}.nav-cta{display:none!important}.stats-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:640px){.wrap{width:min(var(--max),calc(100% - 28px))}.nav{height:66px}.menu-btn{display:block}.navlinks{display:none;position:absolute;top:66px;left:0;right:0;background:#0d1020;border-bottom:1px solid var(--line);padding:12px 14px;flex-direction:column;align-items:stretch}.navlinks.open{display:flex}.navlinks a{padding:11px}.hero{padding:49px 0 33px}h1{letter-spacing:-2.8px}.hero p{font-size:15px}.hero-art{min-height:260px}.orbit{width:230px;height:230px}.cube{width:100px;height:100px;font-size:42px}.fc-top{right:0}.fc-bottom{left:0}.section{padding:42px 0}.section-head{align-items:flex-start;flex-direction:column}.feature-grid,.tools-grid{grid-template-columns:1fr}.stats-grid{gap:9px}.stat-card{padding:14px}.stat-number{font-size:24px}.panel{padding:15px}.list-tools{align-items:stretch;flex-direction:column}.search{width:100%}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}}
