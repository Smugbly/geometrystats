  <script>
    const demons = {
      main:[
        {name:'Acheron',creator:'Ryamu',category:'Extreme Demon',points:100,rank:1},
        {name:'Tidal Wave',creator:'Onilink',category:'Extreme Demon',points:98,rank:2},
        {name:'Thinking Space',creator:'Atomic',category:'Extreme Demon',points:96,rank:3},
        {name:'Silent Clubstep',creator:'TheRealSailent',category:'Extreme Demon',points:94,rank:4},
        {name:'Slaughterhouse',creator:'icedcave',category:'Extreme Demon',points:92,rank:5}
      ],
      upcoming:[
        {name:'The Golden',creator:'SyQual',category:'Upcoming',points:88,rank:1},
        {name:'Unnamed 100%',creator:'Community',category:'Upcoming',points:85,rank:2},
        {name:'Silent clubstep II',creator:'Community',category:'Upcoming',points:82,rank:3}
      ],
      impossible:[
        {name:'Tidal Wave (theoretical)',creator:'Community',category:'Impossible',points:0,rank:1},
        {name:'Beyond Human Limits',creator:'Community',category:'Impossible',points:0,rank:2},
        {name:'One Frame',creator:'Community',category:'Impossible',points:0,rank:3}
      ]
    };
    const players=[
      {name:'Zoink',points:12840,demons:482,top:'Acheron',icon:'Z'},
      {name:'wPopoff',points:11920,demons:451,top:'Tidal Wave',icon:'W'},
      {name:'Doggie',points:10870,demons:426,top:'Thinking Space',icon:'D'},
      {name:'Diamond',points:9760,demons:389,top:'Silent Clubstep',icon:'D'},
      {name:'Cursed',points:8910,demons:361,top:'Slaughterhouse',icon:'C'}
    ];
    let category='main';
    const categoryLabels={main:'Ranked community challenges',upcoming:'Levels proposed or being verified',impossible:'Theoretical and impossible challenges'};
    function renderDemons(){
      const query=document.getElementById('demonSearch').value.trim().toLowerCase();
      const entries=demons[category].filter(d=>(d.name+' '+d.creator+' '+d.category).toLowerCase().includes(query));
      document.getElementById('listCaption').textContent=categoryLabels[category];
      document.getElementById('demonRows').innerHTML=entries.map(d=>`<tr><td class="rank">#${d.rank}</td><td class="level">${d.name}</td><td class="creator">${d.creator}</td><td><span class="badge ${category}">${d.category}</span></td><td class="points">${d.points?d.points+' pts':'—'}</td></tr>`).join('');
      document.getElementById('demonEmpty').hidden=entries.length>0;
    }
    document.querySelectorAll('.tab').forEach(button=>button.addEventListener('click',()=>{
      category=button.dataset.category;
      document.querySelectorAll('.tab').forEach(tab=>{const selected=tab===button;tab.classList.toggle('selected',selected);tab.setAttribute('aria-selected',selected)});
      renderDemons();
    }));
    document.getElementById('demonSearch').addEventListener('input',renderDemons);
    document.getElementById('leaderRows').innerHTML=players.map((p,i)=>`<tr><td class="place">#${i+1}</td><td><div class="leader-card"><div class="avatar">${p.icon}</div><div><b>${p.name}</b><small>Community player</small></div></div></td><td class="points">${p.points.toLocaleString()}</td><td>${p.demons}</td><td>${p.top}</td></tr>`).join('');
    const numberFrom=id=>Math.max(0,Number(document.getElementById(id).value)||0);
    document.getElementById('statsForm').addEventListener('submit',event=>{
      event.preventDefault();
      const name=document.getElementById('playerName').value.trim();
      const stars=numberFrom('stars'),demonsBeaten=numberFrom('demons'),coins=numberFrom('coins'),creator=numberFrom('creatorPoints');
      const result=document.getElementById('statsResult');
      result.innerHTML=`<strong>${name.replace(/[<>]/g,'')}’s snapshot</strong><br><span class="result-num">${stars.toLocaleString()}</span> stars · <strong>${demonsBeaten.toLocaleString()}</strong> demons beaten<br><strong>${coins.toLocaleString()}</strong> user coins · <strong>${creator.toLocaleString()}</strong> creator points`;
      result.classList.add('show');
    });
    document.getElementById('calcForm').addEventListener('submit',event=>{
      event.preventDefault();
      const placement=Math.max(1,numberFrom('placement'));
      const progress=Math.min(100,numberFrom('progress'));
      const categoryKey=document.getElementById('calcCategory').value;
      const multipliers={main:100,upcoming:65,impossible:0};
      const base=multipliers[categoryKey]/Math.sqrt(placement);
      const estimate=base*(progress/100);
      const result=document.getElementById('calcResult');
      result.innerHTML=`<strong>Estimated points</strong><br><span class="result-num">${estimate.toFixed(1)}</span> pts <span class="note">(${progress}% progress · #${placement} placement)</span>`;
      result.classList.add('show');
    });
    const menuBtn=document.getElementById('menuBtn'),navlinks=document.getElementById('navlinks');
    menuBtn.addEventListener('click',()=>{const open=navlinks.classList.toggle('open');menuBtn.setAttribute('aria-expanded',open)});
    navlinks.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{navlinks.classList.remove('open');menuBtn.setAttribute('aria-expanded','false')}));
    renderDemons();
  </script>
</body>
</html>
